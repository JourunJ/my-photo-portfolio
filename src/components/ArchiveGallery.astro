---
import type { ImageMetadata } from 'astro';
import { renderPhoto, GRID_SIZES } from '../lib/photos';
import Lightbox from './Lightbox.astro';
import { digital, analog, type GalleryPhoto } from '../data/galleries';
import exifr from 'exifr';
import path from 'node:path';

const imageModules = {
  digital: import.meta.glob<{ default: ImageMetadata }>(
    '../assets/digital/*.{jpg,jpeg,png,webp,avif,JPG,JPEG,PNG,WEBP,AVIF}',
    { eager: true }
  ),
  analog: import.meta.glob<{ default: ImageMetadata }>(
    '../assets/analog/*.{jpg,jpeg,png,webp,avif,JPG,JPEG,PNG,WEBP,AVIF}',
    { eager: true }
  ),
};

const metadata = new Map<string, GalleryPhoto>();

for (const entry of [...digital, ...analog]) {
  metadata.set(entry.file, entry);
}

const entries = Object.entries({
  ...imageModules.digital,
  ...imageModules.analog,
}).sort(([pathA], [pathB]) => {
  const a = metadata.get(pathA.split('/').pop()!);
  const b = metadata.get(pathB.split('/').pop()!);

  return (
    (b?.year ?? 0) - (a?.year ?? 0) ||
    (b?.month ?? 0) - (a?.month ?? 0) ||
    pathA.localeCompare(pathB, undefined, { numeric: true })
  );
});

const MONTHS = [
  'January', 'February', 'March', 'April', 'May', 'June',
  'July', 'August', 'September', 'October', 'November', 'December',
];

function describe(entry: GalleryPhoto | undefined): string {
  if (!entry) return '';

  const date =
    entry.year > 0 && entry.month >= 1 && entry.month <= 12
      ? `${MONTHS[entry.month - 1]} ${entry.year}`
      : '';

  const location = entry.location.trim();

  if (date && location) return `${date}, ${location}`;
  return date || location;
}

function fallbackAlt(path: string, index: number): string {
  const name = path.split('/').pop()!.replace(/\.[^.]+$/, '');
  const words = name.replace(/^[\s\d_-]+/, '').replace(/[-_]+/g, ' ').trim();

  return words
    ? words.charAt(0).toUpperCase() + words.slice(1)
    : `Photograph ${index + 1}`;
}

const photos = await Promise.all(
  entries.map(async ([filePath, mod], index) => {
    const filename = filePath.split('/').pop()!;
    const entry = metadata.get(filename);

    // 读取原始图片文件的 EXIF 拍摄日期
    const sourcePath = path.resolve(
      process.cwd(),
      'src',
      filePath.replace(/^\.\.\//, '')
    );

    let captureDate: Date | null = null;

    try {
      const exif = await exifr.parse(sourcePath, [
        'DateTimeOriginal',
        'CreateDate',
      ]);

      const date = exif?.DateTimeOriginal ?? exif?.CreateDate;

      if (date instanceof Date && !Number.isNaN(date.getTime())) {
        captureDate = date;
      }
    } catch {
      // 没有 EXIF 或无法读取时，使用手动填写的信息
    }

    const rendered = await renderPhoto(mod.default);

    const year =
      captureDate?.getFullYear() ??
      (entry && entry.year > 0 ? entry.year : null);

    const month =
      captureDate?.getMonth() !== undefined
        ? captureDate.getMonth() + 1
        : entry && entry.month >= 1 && entry.month <= 12
          ? entry.month
          : null;

    const dateLabel =
      year !== null && month !== null
        ? `${MONTHS[month - 1]} ${year}`
        : '';

    const location = entry?.location.trim() ?? '';
    const caption = [dateLabel, location].filter(Boolean).join(', ');

    return {
      ...rendered,
      filename,
      year,
      sortTime:
        captureDate?.getTime() ??
        (year !== null && month !== null
          ? new Date(year, month - 1, 1).getTime()
          : 0),
      caption,
      alt: caption || fallbackAlt(filePath, index),
    };
  })
);


const groups = new Map<string, typeof photos>();

for (const photo of photos) {
  const key = photo.year === null ? 'Undated' : String(photo.year);

  if (!groups.has(key)) groups.set(key, []);
  groups.get(key)!.push(photo);
}

for (const yearPhotos of groups.values()) {
  yearPhotos.sort(
    (a, b) =>
      b.sortTime - a.sortTime ||
      a.filename.localeCompare(b.filename, undefined, {
        numeric: true,
      })
  );
}

for (const yearPhotos of groups.values()) {
  yearPhotos.sort(
    (a, b) =>
      b.sortTime - a.sortTime ||
      a.filename.localeCompare(b.filename, undefined, {
        numeric: true,
      })
  );
}

const sortedGroups = [...groups.entries()].sort(([a], [b]) => {
  if (a === 'Undated') return 1;
  if (b === 'Undated') return -1;
  return Number(b) - Number(a);
});
---

{sortedGroups.length === 0 ? (
  <p class="archive-empty">
    No photos yet. Add images to <code>src/assets/digital/</code> or
    <code>src/assets/analog/</code>.
  </p>
) : (
  <div class="archive">
    {sortedGroups.map(([year, yearPhotos]) => (
      <section class="archive-year" aria-label={`${year} photographs`}>
        <h2 class="archive-year__title">{year}</h2>

        <div class="archive-grid">
          {yearPhotos.map((photo, index) => (
            <figure class="archive-item">
              <button
                class="photo-tile archive-tile"
                type="button"
                aria-label={`${photo.alt} — view larger`}
                data-full={photo.full}
                data-alt={photo.alt}
                data-caption={photo.caption}
              >
                <img
                  class="photo__img archive-img"
                  src={photo.src}
                  srcset={photo.srcset}
                  sizes={GRID_SIZES}
                  alt={photo.alt}
                  loading={index < 4 ? 'eager' : 'lazy'}
                  decoding="async"
                  draggable={false}
                />
              </button>

              {photo.caption && (
                <figcaption class="archive-caption">
                  {photo.caption}
                </figcaption>
              )}
            </figure>
          ))}
        </div>
      </section>
    ))}
  </div>
)}

<Lightbox />

<style>
